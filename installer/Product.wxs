<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DPC Reader" Manufacturer="DPC Reader project" Version="0.3.1"
           UpgradeCode="6B0F2C5E-3B7B-4E0A-9C61-2F5B8D1E7A44" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of DPC Reader is already installed." />
    <!-- Everything the app needs (Python, C++ runtime, libraries) is inside this installer;
         the only requirement is 64-bit Windows 10 or 11 (VersionNT 603 = Windows 8.1 / 10+). -->
    <Launch Condition="Installed OR (VersionNT64 AND VersionNT &gt;= 603)"
            Message="DPC Reader needs 64-bit Windows 10 or Windows 11." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DPC Reader" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <Feature Id="Main" Title="DPC Reader">
      <Files Directory="INSTALLFOLDER" Include="..\dist\DPCReader\**" />
      <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="C1B0B7B0-6E4B-4B8F-9A0E-0C7B0F3A9D11">
        <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="DPC Reader"
                  Target="[INSTALLFOLDER]DPCReader.exe" WorkingDirectory="INSTALLFOLDER"
                  Description="Read Fluke 74x/75x calibrator memory" />
        <Shortcut Id="Desktop" Directory="DesktopFolder" Name="DPC Reader"
                  Target="[INSTALLFOLDER]DPCReader.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\DPCReader" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
